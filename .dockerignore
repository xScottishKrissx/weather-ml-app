
# Exclude Git repository metadata.
.git

# Exclude Python-generated bytecode directories.
__pycache__/

# Exclude compiled Python bytecode files.
*.pyc

# Exclude local Python virtual environments.
.venv/

# Exclude alternative local virtual environment directories.
venv/

# Exclude local environment variable files that may contain secrets.
.env

# Exclude Kubernetes configurations, which aren't required by Flask at runtime.
k8s/

# Exclude test files from the application runtime image.
tests/
